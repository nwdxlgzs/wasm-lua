From: wasm-lua commercial integration
Subject: [PATCH] lexer: accept validated UTF-8 bytes in identifiers
Upstream: Lua 5.5.1
Upstream-SHA256: 1c4b4068d67061f2a2231ad2b5422e77acea1487ea9890f6320af614f4373dce

Lua strings and comments already preserve UTF-8. This patch extends names so
Chinese identifiers are accepted too, while rejecting malformed, overlong,
surrogate, and out-of-range UTF-8 sequences.

--- a/src/lctype.h
+++ b/src/lctype.h
@@ -48,8 +48,10 @@
 /*
 ** 'lalpha' (Lua alphabetic) and 'lalnum' (Lua alphanumeric) both include '_'
 */
-#define lislalpha(c)	testprop(c, MASK(ALPHABIT))
-#define lislalnum(c)	testprop(c, (MASK(ALPHABIT) | MASK(DIGITBIT)))
+#define lisutf8byte(c)	((c) >= 0x80 && (c) <= 0xFF)
+#define lislalpha(c)	(testprop(c, MASK(ALPHABIT)) || lisutf8byte(c))
+#define lislalnum(c)	(testprop(c, (MASK(ALPHABIT) | MASK(DIGITBIT))) || \
+                         lisutf8byte(c))
 #define lisdigit(c)	testprop(c, MASK(DIGITBIT))
 #define lisspace(c)	testprop(c, MASK(SPACEBIT))
 #define lisprint(c)	testprop(c, MASK(PRINTBIT))
@@ -80,8 +82,9 @@
 #include <ctype.h>
 
 
-#define lislalpha(c)	(isalpha(c) || (c) == '_')
-#define lislalnum(c)	(isalnum(c) || (c) == '_')
+#define lisutf8byte(c)	((c) >= 0x80 && (c) <= 0xFF)
+#define lislalpha(c)	(isalpha(c) || (c) == '_' || lisutf8byte(c))
+#define lislalnum(c)	(isalnum(c) || (c) == '_' || lisutf8byte(c))
 #define lisdigit(c)	(isdigit(c))
 #define lisspace(c)	(isspace(c))
 #define lisprint(c)	(isprint(c))
--- a/src/llex.c
+++ b/src/llex.c
@@ -72,6 +72,47 @@ static void save (LexState *ls, int c) {
 }
 
 
+/*
+** Validate non-ASCII bytes accepted by 'lislalpha'. Keeping validation in
+** the lexer makes names deterministic and locale-independent on every host.
+*/
+static int valid_utf8_name (const char *text, size_t length) {
+  const unsigned char *s = cast(const unsigned char *, text);
+  size_t i = 0;
+  while (i < length) {
+    unsigned int c = s[i++];
+    int continuation;
+    if (c < 0x80) continue;
+    if (c >= 0xC2 && c <= 0xDF)
+      continuation = 1;
+    else if (c >= 0xE0 && c <= 0xEF) {
+      if (i >= length) return 0;
+      if ((c == 0xE0 && (s[i] < 0xA0 || s[i] > 0xBF)) ||
+          (c == 0xED && (s[i] < 0x80 || s[i] > 0x9F)) ||
+          (c != 0xE0 && c != 0xED && (s[i] < 0x80 || s[i] > 0xBF)))
+        return 0;
+      i++;
+      continuation = 1;
+    }
+    else if (c >= 0xF0 && c <= 0xF4) {
+      if (i >= length) return 0;
+      if ((c == 0xF0 && (s[i] < 0x90 || s[i] > 0xBF)) ||
+          (c == 0xF4 && (s[i] < 0x80 || s[i] > 0x8F)) ||
+          (c != 0xF0 && c != 0xF4 && (s[i] < 0x80 || s[i] > 0xBF)))
+        return 0;
+      i++;
+      continuation = 2;
+    }
+    else return 0;
+    while (continuation-- > 0) {
+      if (i >= length || s[i] < 0x80 || s[i] > 0xBF) return 0;
+      i++;
+    }
+  }
+  return 1;
+}
+
+
 /*
 ** increment line number and skips newline sequence (any of
 ** \n, \r, \n\r, or \r\n)
@@ -564,6 +605,9 @@ static int llex (LexState *ls, SemInfo *seminfo) {
           do {
             save_and_next(ls);
           } while (lislalnum(ls->current));
+          if (!valid_utf8_name(luaZ_buffer(ls->buff),
+                               luaZ_bufflen(ls->buff)))
+            lexerror(ls, "invalid UTF-8 sequence in identifier", TK_NAME);
           /* find or create string */
           ts = luaS_newlstr(ls->L, luaZ_buffer(ls->buff),
                                    luaZ_bufflen(ls->buff));
